          "carta_id": 50,
          "carta_categoria": "duda",
          "carta_texto": "Vestía de forma extravagante; yo diría que no era de clase media, alguien joven o quizás viejo.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 1,
          "carta_categoria": "acusación",
          "carta_texto": "El Carnicero lo hizo. Lo vi salir con las manos limpias y los ojos sucios.",
