          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 10,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino ya tenía la edad de quien no teme nada y el dinero de quien nunca tuvo que temerlo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 11,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino tenía los bolsillos vacíos y sintiendo el peso de los años se negó a llegar a viejo en la miseria. No lo culpo",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 58,
          "carta_categoria": "meta",
          "carta_texto": "Cada acusación que escuché esta noche sonó a verdad. Eso debería asustarnos.",
