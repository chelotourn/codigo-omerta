          "edad": "joven",
          "carta_id": 25,
          "carta_categoria": "veracidad",
          "carta_texto": "La experiencia no se oculta. Quien tiene mediana edad ya ha aprendido a mentir y lo hará.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 28,
          "carta_categoria": "veracidad",
          "carta_texto": "Los jóvenes de hoy no tienen respeto por la verdad. Al menos uno de ellos miente.",
