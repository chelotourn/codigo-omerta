          "clase": "rico",
          "edad": "viejo",
          "carta_id": 22,
          "carta_categoria": "veracidad",
          "carta_texto": "Desconfíe de todos esos ricos. El porte les da una confianza que cuesta distinguir de la inocencia.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "media",
          "edad": "joven",
          "carta_id": 58,
          "carta_categoria": "meta",
          "carta_texto": "Cada acusación que escuché esta noche sonó a verdad. Eso debería asustarnos.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 45,
          "carta_categoria": "duda",
          "carta_texto": "Me temo que no podrá resolver este caso Detective, el tiempo juega en su contra.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 5,
          "carta_categoria": "acusación",
          "carta_texto": "La Aprendiz aprendió demasiado rápido. Y alguien pagó el precio.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 12,
          "carta_categoria": "defensa",
          "carta_texto": "El Notario no tiene el temple. Conozco a los que pueden hacer algo así. Él no.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 16,
          "carta_categoria": "defensa",
          "carta_texto": "Ni el Notario ni el Coronel. Ambos estaban conmigo cuando ocurrió.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 2,
