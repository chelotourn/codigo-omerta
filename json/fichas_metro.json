          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 3,
          "carta_categoria": "acusación",
          "carta_texto": "Solo el Médico sabe cómo borrar lo que no quiere que se encuentre.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 53,
          "carta_categoria": "grupal",
          "carta_texto": "La Vidente y el Médico compartían secretos. Alguno de esos secretos mató.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 32,
          "carta_categoria": "descriptiva",
          "carta_texto": "El asesino no era rico ni pobre. Clase media. Alguien que pasa desapercibido. Eso ya dice algo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 10,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino ya tenía la edad de quien no teme nada y el dinero de quien nunca tuvo que temerlo.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 50,
          "carta_categoria": "duda",
          "carta_texto": "Vestía de forma extravagante; yo diría que no era de clase media, alguien joven o quizás viejo.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 47,
          "carta_categoria": "duda",
          "carta_texto": "La billetera no le pesaba tanto como para ser rico y cara no le brillaba con la estupidez de un joven.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 6,
