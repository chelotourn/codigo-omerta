          "clase": "rico",
          "edad": "mediana",
          "carta_id": 23,
          "carta_categoria": "veracidad",
          "carta_texto": "A su edad los viejos ya no se gastan en mentir. No temen a la verdad.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 62,
          "carta_categoria": "meta",
          "carta_texto": "Quien recurre a la mentira en esta sala delata su propia culpa; la inocencia es, por naturaleza, honesta.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 17,
          "carta_categoria": "defensa",
          "carta_texto": "Ni la Aprendiz ni la Vidente. Las dos tienen coartada. Yo mismo la verifiqué.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
