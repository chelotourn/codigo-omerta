          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 40,
          "carta_categoria": "descriptiva",
          "carta_texto": "Era rico y de mediana edad. Esa combinación no abunda en esta sala.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
