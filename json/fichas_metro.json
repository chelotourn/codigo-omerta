          "carta_id": 69,
          "carta_categoria": "indirecta",
          "carta_texto": "Cuando alguien de la clase media miente, suele ser por sentimentalismo. Ese viejo impulso de proteger a los más jóvenes.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 43,
          "carta_categoria": "duda",
          "carta_texto": "No estoy seguro, era pobre, y quizás joven o de mediana edad pero no viejo",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 44,
          "carta_categoria": "duda",
          "carta_texto": "Es inutil mentir, al final usted descubre la verdad.",
