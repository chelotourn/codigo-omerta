          "clase": "media",
          "edad": "joven",
          "carta_id": 28,
          "carta_categoria": "veracidad",
          "carta_texto": "Los jóvenes de hoy no tienen respeto por la verdad. Al menos uno de ellos miente.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 33,
          "carta_categoria": "descriptiva",
          "carta_texto": "El asesino era pobre. Su aliento olía a mandarina. Nunca lo olvidaré.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 50,
          "carta_categoria": "duda",
          "carta_texto": "Vestía de forma extravagante; yo diría que no era de clase media, alguien joven o quizás viejo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 2,
          "carta_categoria": "acusación",
          "carta_texto": "El Notario. Nadie más conocía la hora exacta. Nadie más tenía motivo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 20,
          "carta_categoria": "defensa",
          "carta_texto": "Quien lo hizo no era de mediana edad. Esta claro pues no tuvo la fuerza para mover el cuerpo.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
