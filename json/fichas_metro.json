        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 39,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable no era ni rico ni viejo. Lo que vi fue a alguien que podría confundirse con cualquiera.",
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 5,
