          "clase": "pobre",
          "edad": "joven",
          "carta_id": 7,
          "carta_categoria": "acusación",
          "carta_texto": "Solo el El Vagabundo o el Crupier estaban en la escena del crimen. Uno de ellos lo hizo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 14,
          "carta_categoria": "defensa",
          "carta_texto": "El Coronel lleva años protegiéndonos. Acusarlo es insultarnos a todos.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 56,
          "carta_categoria": "grupal",
          "carta_texto": "Somos un grupo grande, algunos demasiado jóvenes otros demasiado viejos, y luego está el asesino.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 12,
          "carta_categoria": "defensa",
          "carta_texto": "El Notario no tiene el temple. Conozco a los que pueden hacer algo así. Él no.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 51,
          "carta_categoria": "grupal",
          "carta_texto": "El Coronel y el Notario llegaron juntos esa noche. Solo uno de ellos sabe por qué.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 63,
          "carta_categoria": "meta",
          "carta_texto": "Alguien acusa y alguien defiende, y ambos dicen la verdad. Eso es una contradicción. O es una trampa.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 3,
      "distrito_id": 1,
      "distrito_nombre": "Distrito Industrial",
      "es_conclusion": false,
