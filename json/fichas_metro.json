        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 42,
          "carta_categoria": "duda",
          "carta_texto": "Hay uno solo que miente en esta sala. Solo uno. Y ese uno soy yo.",
          "silenciada": false,
          "es_verdad": false
