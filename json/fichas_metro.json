      ],
      "modo": "verdades",
      "cantidad": 4,
      "dificultad": "metropoli",
      "culpable_id": 2,
      "culpable_nombre": "La Aprendiz",
      "declaraciones": [
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "media",
          "edad": "joven",
          "carta_id": 19,
          "carta_categoria": "defensa",
          "carta_texto": "El culpable no era rico. Vi sus ropas. Menuda falta de gusto.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 45,
          "carta_categoria": "duda",
          "carta_texto": "Me temo que no podrá resolver este caso Detective, el tiempo juega en su contra.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 11,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino tenía los bolsillos vacíos y sintiendo el peso de los años se negó a llegar a viejo en la miseria. No lo culpo",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 48,
          "carta_categoria": "duda",
          "carta_texto": "Mire, no parecía uno de esos ricos; yo diría que o tenía un pie en la tumba o apenas los había sacado de la cuna.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 34,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era joven. El crujido de sus pasos era ligero. La juventud tiene ese peso.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 13,
          "carta_categoria": "defensa",
          "carta_texto": "El culpable no era ni rico ni viejo. Lo que vi fue a alguien que podría confundirse con cualquiera.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
