          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 53,
          "carta_categoria": "grupal",
          "carta_texto": "La Vidente y el Médico compartían secretos. Alguno de esos secretos mató.",
