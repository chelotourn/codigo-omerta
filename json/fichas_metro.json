          "carta_id": 18,
          "carta_categoria": "defensa",
          "carta_texto": "Ni el Carnicero ni el Médico. Sus herramientas no cuadran con lo que vi.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 66,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el Vagabundo miente, entonces el asesino vino de abajo. La pobreza no es excusa, pero sí es pista.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 49,
          "carta_categoria": "duda",
          "carta_texto": "No estoy muy seguro; no era joven ni tampoco parecía pobre. Siento no poder aportar más.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 35,
          "carta_categoria": "descriptiva",
          "carta_texto": "Tenía mi misma edad, más o menos. Mediana. Lo vi en la forma de moverse.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 41,
          "carta_categoria": "duda",
          "carta_texto": "Yo no he sido ni sé quién pudo hacerlo. Pero sé que lo volverá a hacer si no lo encontramos.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 22,
          "carta_categoria": "veracidad",
          "carta_texto": "Desconfíe de todos esos ricos. El porte les da una confianza que cuesta distinguir de la inocencia.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 2,
