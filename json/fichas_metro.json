          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 43,
          "carta_categoria": "duda",
          "carta_texto": "No estoy seguro, era pobre, y quizás joven o de mediana edad pero no viejo",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 32,
          "carta_categoria": "descriptiva",
          "carta_texto": "El asesino no era rico ni pobre. Clase media. Alguien que pasa desapercibido. Eso ya dice algo.",
