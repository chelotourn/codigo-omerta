        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 28,
          "carta_categoria": "veracidad",
          "carta_texto": "Los jóvenes de hoy no tienen respeto por la verdad. Al menos uno de ellos miente.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 38,
          "carta_categoria": "descriptiva",
          "carta_texto": "Quien buscas tenía la misma edad que la Aprendiz. Eso y su misma frialdad.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 18,
          "carta_categoria": "defensa",
          "carta_texto": "Ni el Carnicero ni el Médico. Sus herramientas no cuadran con lo que vi.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 5,
          "carta_categoria": "acusación",
          "carta_texto": "La Aprendiz aprendió demasiado rápido. Y alguien pagó el precio.",
