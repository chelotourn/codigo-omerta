          "clase": "pobre",
          "edad": "joven",
          "carta_id": 34,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era joven. El crujido de sus pasos era ligero. La juventud tiene ese peso.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "media",
          "edad": "joven",
          "carta_id": 56,
          "carta_categoria": "grupal",
          "carta_texto": "Somos un grupo grande, algunos demasiado jóvenes otros demasiado viejos, y luego está el asesino.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 70,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el culpable esgrime una defensa esta noche, algún inocente también miente para cubrirlo. La complicidad tiene sus reglas.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 4,
          "carta_categoria": "acusación",
          "carta_texto": "La Vidente sabía lo que iba a pasar. Pero no creo en sus visiones, creo que lo planificó.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 29,
          "carta_categoria": "veracidad",
          "carta_texto": "Entre tanta gente pobre seguro hay algun mentiroso. Así es esta gente.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 5,
      "distrito_id": 1,
      "distrito_nombre": "Distrito Industrial",
      "es_conclusion": false,
      "n_sospechosos": 4,
      "sospechosos_ids": [
        3,
        4,
        5,
