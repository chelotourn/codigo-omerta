        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "media",
          "edad": "joven",
          "carta_id": 71,
          "carta_categoria": "indirecta",
          "carta_texto": "Si la mayoria de los demás sospechosos miente, el culpable tiene años encima. La vejez enseña a esconderse.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 41,
          "carta_categoria": "duda",
          "carta_texto": "Yo no he sido ni sé quién pudo hacerlo. Pero sé que lo volverá a hacer si no lo encontramos.",
