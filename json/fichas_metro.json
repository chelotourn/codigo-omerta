          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 30,
          "carta_categoria": "veracidad",
          "carta_texto": "Curiosamente, quienes dicen la verdad esta noche podrían perfectamente comprarla.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 9,
          "carta_categoria": "acusación",
          "carta_texto": "Fue la Aprendiz o la Vidente. El instinto lo dice. Las pruebas, también.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 38,
          "carta_categoria": "descriptiva",
          "carta_texto": "Quien buscas tenía la misma edad que la Aprendiz. Eso y su misma frialdad.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
