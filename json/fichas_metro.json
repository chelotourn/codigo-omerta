          "clase": "pobre",
          "edad": "joven",
          "carta_id": 17,
          "carta_categoria": "defensa",
          "carta_texto": "Ni la Aprendiz ni la Vidente. Las dos tienen coartada. Yo mismo la verifiqué.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 2,
          "carta_categoria": "acusación",
          "carta_texto": "El Notario. Nadie más conocía la hora exacta. Nadie más tenía motivo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 35,
          "carta_categoria": "descriptiva",
          "carta_texto": "Tenía mi misma edad, más o menos. Mediana. Lo vi en la forma de moverse.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 25,
          "carta_categoria": "veracidad",
          "carta_texto": "La experiencia no se oculta: al menos uno de mediana edad miente esta noche, aunque no sepamos cuál.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 58,
          "carta_categoria": "meta",
          "carta_texto": "Cada acusación que escuché esta noche sonó a verdad. Eso debería asustarnos.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 5,
