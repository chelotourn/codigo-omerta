        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 34,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era joven. El crujido de sus pasos era ligero. La juventud tiene ese peso.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 44,
          "carta_categoria": "duda",
          "carta_texto": "Es inutil mentir, al final usted descubre la verdad.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 21,
          "carta_categoria": "veracidad",
          "carta_texto": "Todos esos viejos en la sala saben más de lo que dicen. Eligieron con cuidado que contar y sobre todo que ocultar.",
          "silenciada": false,
          "es_verdad": false
        },
