          "clase": "media",
          "edad": "joven",
          "carta_id": 31,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era rico. Estoy seguro. El coche que abandonó la escena era de alta gama.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 46,
          "carta_categoria": "duda",
          "carta_texto": "Aqui el dinero se huele, y ese tipo no apestaba a clase media. Tampoco arrastraba los pies como un viejo. Es todo lo que sé.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 29,
          "carta_categoria": "veracidad",
          "carta_texto": "Entre tanta gente pobre seguro hay algun mentiroso. Así es esta gente.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 47,
          "carta_categoria": "duda",
          "carta_texto": "La billetera no le pesaba tanto como para ser rico y su cara no brillaba con la estupidez de un joven.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 13,
          "carta_categoria": "defensa",
          "carta_texto": "El culpable no era ni rico ni viejo. Lo que vi fue a alguien que podría confundirse con cualquiera.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
