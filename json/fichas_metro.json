        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 13,
          "carta_categoria": "defensa",
          "carta_texto": "El Carnicero es muchas cosas. Un asesino no es una de ellas. Que quede claro.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 62,
          "carta_categoria": "meta",
          "carta_texto": "Hay uno solo que miente en esta sala. Solo uno. Y ese uno soy yo.",
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 2,
      "distrito_id": 2,
