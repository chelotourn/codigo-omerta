          "carta_id": 63,
          "carta_categoria": "meta",
          "carta_texto": "Alguien acusa y alguien defiende, y ambos dicen la verdad. Eso es una contradicción. O es una trampa.",
          "silenciada": false,
          "es_verdad": true
        },
        {
