      "declaraciones": [
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 59,
          "carta_categoria": "meta",
          "carta_texto": "El culpable no se está defendiendo. Eso es incluso más peligroso. Ande con cuidado.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 15,
          "carta_categoria": "defensa",
          "carta_texto": "El Médico juró no hacer daño. Y lo cumple. Eso no se finge.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 49,
          "carta_categoria": "duda",
          "carta_texto": "No estoy muy seguro; no era joven ni tampoco parecía pobre. Siento no poder aportar más.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 23,
          "carta_categoria": "veracidad",
          "carta_texto": "A su edad los viejos ya no se gastan en mentir. No temen a la verdad.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 5,
      "distrito_id": 1,
      "distrito_nombre": "Distrito Industrial",
      "es_conclusion": false,
      "n_sospechosos": 6,
      "sospechosos_ids": [
