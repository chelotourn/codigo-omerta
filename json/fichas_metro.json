        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 62,
          "carta_categoria": "meta",
          "carta_texto": "Hay uno solo que miente en esta sala. Solo uno. Y ese uno soy yo.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 13,
          "carta_categoria": "defensa",
          "carta_texto": "El culpable no era ni rico ni viejo. Lo que vi fue a alguien que podría confundirse con cualquiera.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 4,
          "carta_categoria": "acusación",
          "carta_texto": "La Vidente sabía lo que iba a pasar. Pero no creo en sus visiones, creo que lo planificó.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 31,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era rico. Estoy seguro. El coche que abandonó la escena era de alta gama.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 35,
          "carta_categoria": "descriptiva",
          "carta_texto": "Tenía mi misma edad, más o menos. Mediana. Lo vi en la forma de moverse.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
    },
