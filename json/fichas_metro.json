      "culpable_id": 8,
      "culpable_nombre": "El Crupier",
      "declaraciones": [
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 49,
          "carta_categoria": "duda",
          "carta_texto": "No estoy muy seguro; no era joven ni tampoco parecía pobre. Siento no poder aportar más.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 24,
          "carta_categoria": "veracidad",
          "carta_texto": "Los pobres no mienten pues hoy han comido bien. Yo les creo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 19,
          "carta_categoria": "defensa",
          "carta_texto": "El culpable no era rico. Vi sus ropas. Menuda falta de gusto.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 50,
          "carta_categoria": "duda",
          "carta_texto": "Vestía de forma extravagante; yo diría que no era de clase media y era alguien joven o quizás viejo.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 6,
      "distrito_id": 2,
      "distrito_nombre": "Distrito Comercial",
      "es_conclusion": false,
      "n_sospechosos": 4,
      "sospechosos_ids": [
        3,
        4,
        8,
        9
      ],
      "modo": "verdades",
      "cantidad": 2,
      "dificultad": "metropoli",
      "culpable_id": 9,
      "culpable_nombre": "El Vagabundo",
      "declaraciones": [
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "media",
          "edad": "joven",
          "carta_id": 61,
          "carta_categoria": "meta",
          "carta_texto": "Al menos una descripción dicha en esta sala suena convincente. Aférrese a esa y le llevará al culpable.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 39,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable no era ni rico ni viejo. Lo que vi fue a alguien que podría confundirse con cualquiera.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 11,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino tenía los bolsillos vacíos y sintiendo el peso de los años se negó a llegar a viejo en la miseria. No lo culpo",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 41,
          "carta_categoria": "duda",
          "carta_texto": "Yo no he sido ni sé quién pudo hacerlo. Pero sé que lo volverá a hacer si no lo encontramos.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 7,
