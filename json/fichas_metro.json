          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 54,
          "carta_categoria": "grupal",
          "carta_texto": "Los e en esta sala se cubren entre sí. Uno de ellos miente, uno de ellos lo hizo y no podra esconderlo.",
