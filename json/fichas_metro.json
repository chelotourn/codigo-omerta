          "carta_id": 27,
          "carta_categoria": "veracidad",
          "carta_texto": "Los de clase media no mienten. Son de fiar.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "media",
          "edad": "joven",
          "carta_id": 68,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el Crupier miente, quien lo hizo no era viejo. Son los únicos a los que él nunca defendería.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 47,
          "carta_categoria": "duda",
          "carta_texto": "La billetera no le pesaba tanto como para ser rico y su cara no brillaba con la estupidez de un joven.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 46,
          "carta_categoria": "duda",
          "carta_texto": "Aqui el dinero se huele, y ese tipo no apestaba a clase media. Tampoco arrastraba los pies como un viejo. Es todo lo que sé.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 30,
          "carta_categoria": "veracidad",
          "carta_texto": "Curiosamente, quienes dicen la verdad esta noche podrían perfectamente comprarla.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
