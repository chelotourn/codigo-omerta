      "declaraciones": [
        {
          "sospechoso_id": 1,
          "sospechoso": "El Notario",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 42,
          "carta_categoria": "duda",
          "carta_texto": "Hay uno solo que miente en esta sala. Solo uno. Y ese uno soy yo.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "media",
          "edad": "joven",
          "carta_id": 22,
          "carta_categoria": "veracidad",
          "carta_texto": "Desconfíe de todos esos ricos. El porte les da una confianza que cuesta distinguir de la inocencia.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 10,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino ya tenía la edad de quien no teme nada y el dinero de quien nunca tuvo que temerlo.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 51,
          "carta_categoria": "grupal",
          "carta_texto": "El Coronel y el Notario llegaron juntos esa noche. Solo uno de ellos sabe por qué.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 70,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el culpable no duda esta noche, entonces quien acusa miente. La certeza es un lujo que solo se permite quien no teme ser descubierto.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 2,
      "distrito_id": 2,
      "distrito_nombre": "Distrito Comercial",
      "es_conclusion": false,
      "n_sospechosos": 4,
