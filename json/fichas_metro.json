        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 21,
          "carta_categoria": "veracidad",
          "carta_texto": "Todos esos viejos en la sala saben más de lo que dicen. Eligieron con cuidado que contar y sobre todo que ocultar.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 43,
          "carta_categoria": "duda",
          "carta_texto": "No estoy seguro, era pobre, y quizás joven o de mediana edad pero no viejo",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 41,
          "carta_categoria": "duda",
          "carta_texto": "Yo no he sido ni sé quién pudo hacerlo. Pero sé que lo volverá a hacer si no lo encontramos.",
