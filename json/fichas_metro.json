          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 6,
          "carta_categoria": "acusación",
          "carta_texto": "El Coronel fue. Lo delataron sus hábitos, no sus palabras.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 36,
          "carta_categoria": "descriptiva",
          "carta_texto": "Quien lo hizo era viejo. El paso lento, la respiración pausada. Solo la edad da esa calma.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 44,
          "carta_categoria": "duda",
          "carta_texto": "Es inutil mentir, al final usted descubre la verdad.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 39,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era joven de clase media. Alguien que te cruzarías en cualquier instituto.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 37,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era exactamente de la misma clase que el Coronel. Lo noto en su andar.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
