          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 12,
          "carta_categoria": "defensa",
          "carta_texto": "El Notario no tiene el temple. Conozco a los que pueden hacer algo así. Él no.",
