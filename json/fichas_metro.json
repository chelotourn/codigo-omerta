          "clase": "rico",
          "edad": "viejo",
          "carta_id": 57,
          "carta_categoria": "meta",
          "carta_texto": "Alguien defiende en esta sala y está mintiendo. La inocencia no necesita tanto ruido.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "media",
          "edad": "joven",
          "carta_id": 32,
          "carta_categoria": "descriptiva",
          "carta_texto": "El asesino no era rico ni pobre. Clase media. Alguien que pasa desapercibido. Eso ya dice algo.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 20,
          "carta_categoria": "defensa",
          "carta_texto": "Quien lo hizo no era de mediana edad. Esta claro pues no tuvo la fuerza para mover el cuerpo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 50,
          "carta_categoria": "duda",
          "carta_texto": "Vestía de forma extravagante; yo diría que no era de clase media, alguien joven o quizás viejo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 30,
          "carta_categoria": "veracidad",
          "carta_texto": "Curiosamente, quienes dicen la verdad esta noche podrían perfectamente comprarla.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 3,
          "carta_categoria": "acusación",
          "carta_texto": "Solo el Médico sabe cómo borrar lo que no quiere que se encuentre.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 3,
