          "clase": "rico",
          "edad": "mediana",
          "carta_id": 73,
          "carta_categoria": "omerta",
          "carta_texto": "Solo tengo una palabra para usted, detective: Omertá. Quien me acuse, directa o indirectamente, será silenciado.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 2
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 33,
          "carta_categoria": "descriptiva",
          "carta_texto": "El asesino era pobre. Su aliento olía a mandarina. Nunca lo olvidaré.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 2
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 39,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable no era ni rico ni viejo. Lo que vi fue a alguien que podría confundirse con cualquiera.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
