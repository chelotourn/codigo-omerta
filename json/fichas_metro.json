      "culpable_id": 3,
      "culpable_nombre": "El Carnicero",
      "declaraciones": [
        {
          "sospechoso_id": 1,
          "sospechoso": "El Notario",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 1,
          "carta_categoria": "acusación",
          "carta_texto": "El Carnicero lo hizo. Lo vi salir con las manos limpias y los ojos sucios.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 44,
          "carta_categoria": "duda",
          "carta_texto": "Es inutil mentir, al final usted descubre la verdad.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "media",
          "edad": "joven",
          "carta_id": 69,
          "carta_categoria": "indirecta",
          "carta_texto": "Cuando alguien de la clase media miente, suele ser por sentimentalismo. Ese viejo impulso de proteger a los más jóvenes.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 38,
          "carta_categoria": "descriptiva",
          "carta_texto": "Quien buscas tenía la misma edad que la Aprendiz. Eso y su misma frialdad.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 3,
      "distrito_id": 1,
      "distrito_nombre": "Distrito Industrial",
      "es_conclusion": false,
      "n_sospechosos": 6,
      "sospechosos_ids": [
        2,
