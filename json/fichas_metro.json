        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 58,
          "carta_categoria": "meta",
          "carta_texto": "Cada acusación que escuché esta noche sonó a verdad. Eso debería asustarnos.",
