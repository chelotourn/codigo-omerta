      "declaraciones": [
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "media",
          "edad": "joven",
          "carta_id": 18,
          "carta_categoria": "defensa",
          "carta_texto": "Ni el Carnicero ni el Médico. Sus herramientas no cuadran con lo que vi.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 5,
          "carta_categoria": "acusación",
          "carta_texto": "La Aprendiz aprendió demasiado rápido. Y alguien pagó el precio.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 1,
          "carta_categoria": "acusación",
          "carta_texto": "El Carnicero lo hizo. Lo vi salir con las manos limpias y los ojos sucios.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 52,
          "carta_categoria": "grupal",
          "carta_texto": "La Aprendiz y el Carnicero se conocen de antes. Eso no es casualidad.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 2,
