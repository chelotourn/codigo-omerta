        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 68,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el Crupier miente, quien lo hizo no era viejo. Son los únicos a los que él nunca defendería.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 13,
          "carta_categoria": "defensa",
          "carta_texto": "El Carnicero es muchas cosas. Un asesino no es una de ellas. Que quede claro.",
