        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 27,
          "carta_categoria": "veracidad",
          "carta_texto": "Los de clase media no mienten. Son de fiar.",
