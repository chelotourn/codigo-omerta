          "edad": "mediana",
          "carta_id": 39,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era joven de clase media. Alguien que te cruzarías en cualquier instituto.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 46,
          "carta_categoria": "duda",
          "carta_texto": "Aqui el dinero se huele, y ese tipo no apestaba a clase media. Tampoco arrastraba los pies como un viejo. Es todo lo que sé.",
          "silenciada": false,
          "es_verdad": false
        },
        {
