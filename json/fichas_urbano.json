          "carta_id": 55,
          "carta_categoria": "grupal",
          "carta_texto": "Los viejos se protegen. Es lo único que les queda. Uno de ellos debe ser el asesino.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 11,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino tenía los bolsillos vacíos y sintiendo el peso de los años se negó a llegar a viejo en la miseria. No lo culpo",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 12,
          "carta_categoria": "defensa",
          "carta_texto": "El Notario no tiene el temple. Conozco a los que pueden hacer algo así. Él no.",
