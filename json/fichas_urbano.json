          "clase": "rico",
          "edad": "viejo",
          "carta_id": 36,
          "carta_categoria": "descriptiva",
          "carta_texto": "Quien lo hizo era viejo. El paso lento, la respiración pausada. Solo la edad da esa calma.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 48,
          "carta_categoria": "duda",
          "carta_texto": "Mire, no parecía uno de esos ricos; yo diría que o tenía un pie en la tumba o apenas los había sacado de la cuna.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 4,
          "carta_categoria": "acusación",
          "carta_texto": "La Vidente sabía lo que iba a pasar. Pero no creo en sus visiones, creo que lo planificó.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 15,
          "carta_categoria": "defensa",
          "carta_texto": "El Médico juró no hacer daño. Y lo cumple. Eso no se finge.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
