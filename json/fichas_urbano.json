          "carta_categoria": "acusación",
          "carta_texto": "El Coronel fue. Lo delataron sus hábitos, no sus palabras.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 20,
          "carta_categoria": "defensa",
          "carta_texto": "Quien lo hizo era joven. Lo delataba el nerviosismo. La vejez da paciencia para el crimen.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 25,
          "carta_categoria": "veracidad",
          "carta_texto": "La experiencia no se oculta. Quien tiene mediana edad ya ha aprendido a mentir y lo hará.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 15,
          "carta_categoria": "defensa",
          "carta_texto": "El Médico juró no hacer daño. Y lo cumple. Eso no se finge.",
