      "declaraciones": [
        {
          "sospechoso_id": 1,
          "sospechoso": "El Notario",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 3,
          "carta_categoria": "acusación",
          "carta_texto": "Solo el Médico sabe cómo borrar lo que no quiere que se encuentre.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 20,
          "carta_categoria": "defensa",
          "carta_texto": "Quien lo hizo no era de mediana edad. Esta claro pues no tuvo la fuerza para mover el cuerpo.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 31,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable era rico. Estoy seguro. El coche que abandonó la escena era de alta gama.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 30,
          "carta_categoria": "veracidad",
          "carta_texto": "Curiosamente, quienes dicen la verdad esta noche podrían perfectamente comprarla.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
