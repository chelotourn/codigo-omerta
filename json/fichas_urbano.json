          "carta_id": 46,
          "carta_categoria": "duda",
          "carta_texto": "Estoy seguro que alguien de clase media tendría mejores cosas que hacer. El resto quizás no.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 11,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino tenía los bolsillos vacíos y sintiendo el peso de los años se negó a llegar a viejo en la miseria. No lo culpo",
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
