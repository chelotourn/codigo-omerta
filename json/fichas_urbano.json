          "carta_id": 10,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino ya tenía la edad de quien no teme nada y el dinero de quien nunca tuvo que temerlo.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "media",
          "edad": "joven",
          "carta_id": 41,
          "carta_categoria": "duda",
          "carta_texto": "Yo no he sido ni sé quién pudo hacerlo. Pero sé que lo volverá a hacer si no lo encontramos.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 49,
          "carta_categoria": "duda",
          "carta_texto": "No estoy muy seguro; no era joven ni tampoco parecía pobre. Siento no poder aportar más.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 48,
          "carta_categoria": "duda",
          "carta_texto": "Mire, no parecía uno de esos ricos; yo diría que o tenía un pie en la tumba o apenas los había sacado de la cuna.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
