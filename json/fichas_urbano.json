          "edad": "mediana",
          "carta_id": 55,
          "carta_categoria": "grupal",
          "carta_texto": "Los viejos se protegen. Es lo único que les queda. Uno de ellos debe ser el asesino.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 10,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino ya tenía la edad de quien no teme nada y el dinero de quien nunca tuvo que temerlo.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 4,
          "carta_categoria": "acusación",
          "carta_texto": "La Vidente sabía lo que iba a pasar. Pero no creo en sus visiones, creo que lo planificó.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 42,
          "carta_categoria": "duda",
          "carta_texto": "Podría haber sido cualquiera. Cualquiera con suficiente razón para odiar.",
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 2,
      "distrito_id": 2,
      "distrito_nombre": "Distrito Comercial",
