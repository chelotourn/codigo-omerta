          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 23,
          "carta_categoria": "veracidad",
          "carta_texto": "A su edad los viejos ya no se gastan en mentir. No temen a la verdad.",
