        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "media",
          "edad": "joven",
          "carta_id": 11,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino tenía los bolsillos vacíos y sintiendo el peso de los años se negó llegar a viejo en la miseria. No lo culpo",
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 41,
          "carta_categoria": "duda",
          "carta_texto": "Yo no he sido ni sé quién pudo hacerlo. Pero sé que lo volverá a hacer si no lo encontramos.",
          "es_verdad": true
        }
      ]
