          "clase": "media",
          "edad": "joven",
          "carta_id": 48,
          "carta_categoria": "duda",
          "carta_texto": "No fue alguien pobre. El reloj que tenía la victima era costoso y allí quedó",
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 25,
          "carta_categoria": "veracidad",
          "carta_texto": "La experiencia no se oculta. Quien tiene mediana edad ya ha aprendido a mentir y lo hará.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 39,
          "carta_categoria": "descriptiva",
          "carta_texto": "El culpable no era ni rico ni viejo. Lo que vi fue a alguien que podría confundirse con cualquiera.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 35,
          "carta_categoria": "descriptiva",
          "carta_texto": "Tenía mi misma edad, más o menos. Mediana. Lo vi en la forma de moverse.",
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 3,
      "distrito_id": 1,
