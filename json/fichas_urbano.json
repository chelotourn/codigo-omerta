        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 13,
          "carta_categoria": "defensa",
          "carta_texto": "El Carnicero es muchas cosas. Un asesino no es una de ellas. Que quede claro.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 56,
          "carta_categoria": "grupal",
          "carta_texto": "Somos un grupo grande, algunos demasiado jóvenes otros demasiado viejos, y luego está el asesino.",
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 5,
