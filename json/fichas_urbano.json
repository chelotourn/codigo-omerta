          "clase": "rico",
          "edad": "viejo",
          "carta_id": 36,
          "carta_categoria": "descriptiva",
          "carta_texto": "Quien lo hizo era viejo. El paso lento, la respiración pausada. Solo la edad da esa calma.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 49,
          "carta_categoria": "duda",
          "carta_texto": "No estoy muy seguro; no era joven ni tampoco parecía pobre. Siento no poder aportar más.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 54,
          "carta_categoria": "grupal",
          "carta_texto": "Los ricos en esta sala se cubren entre sí. Uno de ellos miente, uno de ellos lo hizo y no podra esconderlo.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 16,
          "carta_categoria": "defensa",
          "carta_texto": "Ni el Notario ni el Coronel. Ambos estaban conmigo cuando ocurrió.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 21,
          "carta_categoria": "veracidad",
          "carta_texto": "Esos viejos en la sala saben más de lo que dicen. Eligieron con cuidado que contar y que ocultar.",
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 4,
