          "edad": "mediana",
          "carta_id": 20,
          "carta_categoria": "defensa",
          "carta_texto": "Quien lo hizo era de mediana edad. Esta claro pues no tuvo la fuerza para mover el cuerpo.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 21,
          "carta_categoria": "veracidad",
          "carta_texto": "Todos esos viejos en la sala saben más de lo que dicen. Eligieron con cuidado que contar y sobre todo que ocultar.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 45,
          "carta_categoria": "duda",
          "carta_texto": "Me temo que no podrá resolver este caso Detective, el tiempo juega en su contra.",
          "es_verdad": false
        },
