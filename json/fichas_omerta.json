        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 73,
          "carta_categoria": "omerta",
          "carta_texto": "Solo tengo una palabra para usted, detective: Omertá. Quien me acuse, directa o indirectamente, será silenciado.",
          "es_verdad": true,
          "distrito_origen": 2
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 69,
          "carta_categoria": "indirecta",
          "carta_texto": "Cuando alguien de la clase media miente, suele ser por sentimentalismo. Ese viejo impulso de proteger a los más jóvenes.",
          "es_verdad": false,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 14,
          "carta_categoria": "defensa",
          "carta_texto": "El Coronel lleva años protegiéndonos. Acusarlo es insultarnos a todos.",
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 63,
          "carta_categoria": "meta",
          "carta_texto": "Alguien acusa y alguien defiende, y ambos dicen la verdad. Eso es una contradicción. O es una trampa.",
          "es_verdad": true,
          "distrito_origen": 2
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 70,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el culpable esgrime una defensa esta noche, algún inocente también miente para cubrirlo. La complicidad tiene sus reglas.",
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 17,
          "carta_categoria": "defensa",
          "carta_texto": "Ni la Aprendiz ni la Vidente. Las dos tienen coartada. Yo mismo la verifiqué.",
