          "edad": "viejo",
          "carta_id": 70,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el culpable se defiende esta noche, algún inocente también miente para cubrirlo. La complicidad tiene sus reglas.",
          "es_verdad": true
        }
