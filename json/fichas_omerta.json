          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 13,
          "carta_categoria": "defensa",
          "carta_texto": "El Carnicero es muchas cosas. Un asesino no es una de ellas. Que quede claro.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 57,
          "carta_categoria": "meta",
          "carta_texto": "Quien se defiende en esta sala está mintiendo. La inocencia no necesita tanto ruido.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
