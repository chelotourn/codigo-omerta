      "culpable_id": 7,
      "culpable_nombre": "El Heredero",
      "declaraciones": [
        {
          "sospechoso_id": 1,
          "sospechoso": "El Notario",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 29,
          "carta_categoria": "veracidad",
          "carta_texto": "Entre tanta gente pobre seguro hay algun mentiroso. Así es esta gente.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 10,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino ya tenía la edad de quien no teme nada y el dinero de quien nunca tuvo que temerlo.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 53,
          "carta_categoria": "grupal",
          "carta_texto": "La Vidente y el Médico compartían secretos. Alguno de esos secretos mató.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 44,
          "carta_categoria": "duda",
          "carta_texto": "Es inutil mentir, al final usted descubre la verdad.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 68,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el Archivista miente, quien lo hizo no era joven. Los viejos saben cuándo callar y cuándo actuar.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 12,
          "carta_categoria": "defensa",
          "carta_texto": "El Notario no tiene el temple. Conozco a los que pueden hacer algo así. Él no.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Archivista",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 51,
          "carta_categoria": "grupal",
          "carta_texto": "El Coronel y el Notario llegaron juntos esa noche. Solo uno de ellos sabe por qué.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 35,
          "carta_categoria": "descriptiva",
          "carta_texto": "Tenía mi misma edad, más o menos. Mediana. Lo vi en la forma de moverse.",
          "es_verdad": false
        }
      ]
    },
