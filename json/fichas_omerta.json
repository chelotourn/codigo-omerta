          "carta_id": 24,
          "carta_categoria": "veracidad",
          "carta_texto": "Los pobres no mienten pues hoy han comido bien. Yo les creo.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 30,
          "carta_categoria": "veracidad",
          "carta_texto": "Curiosamente, quienes dicen la verdad esta noche podrían perfectamente comprarla.",
