          "edad": "mediana",
          "carta_id": 20,
          "carta_categoria": "defensa",
          "carta_texto": "Quien lo hizo era joven. Lo delataba el nerviosismo. La vejez da paciencia para el crimen.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 24,
          "carta_categoria": "veracidad",
          "carta_texto": "Los pobres no mienten pues hoy han comido bien. Yo les creo.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 55,
          "carta_categoria": "grupal",
          "carta_texto": "Los viejos se protegen. Es lo único que les queda. Uno de ellos debe ser el asesino.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 56,
          "carta_categoria": "grupal",
          "carta_texto": "Somos un grupo grande, algunos demasiado jóvenes otros demasiado viejos, y luego está el asesino.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Archivista",
