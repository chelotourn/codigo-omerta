          "carta_id": 65,
          "carta_categoria": "indirecta",
          "carta_texto": "Escucho a quienes defienden y quienes describen al culpable, pero si los unos dicen la verdad, los otros mienten.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 23,
          "carta_categoria": "veracidad",
          "carta_texto": "A su edad los viejos ya no se gastan en mentir. No temen a la verdad.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 57,
          "carta_categoria": "meta",
          "carta_texto": "Alguien defiende en esta sala y está mintiendo. La inocencia no necesita tanto ruido.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 18,
          "carta_categoria": "defensa",
          "carta_texto": "Ni el Carnicero ni el Médico. Sus herramientas no cuadran con lo que vi.",
          "silenciada": false,
          "es_verdad": true
        }
      ]
    },
    {
      "ficha_id": 8,
      "distrito_id": 2,
      "distrito_nombre": "Distrito Comercial",
      "es_conclusion": false,
      "n_sospechosos": 7,
