          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 48,
          "carta_categoria": "duda",
          "carta_texto": "No fue alguien pobre. El reloj que tenía la victima era costoso y allí quedó",
