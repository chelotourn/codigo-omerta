          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 25,
          "carta_categoria": "veracidad",
          "carta_texto": "La experiencia no se oculta. Quien tiene mediana edad ya ha aprendido a mentir y lo hará almenos uan vez.",
