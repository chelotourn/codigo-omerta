          "carta_id": 15,
          "carta_categoria": "defensa",
          "carta_texto": "El Médico juró no hacer daño. Y lo cumple. Eso no se finge.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 2
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 32,
          "carta_categoria": "descriptiva",
          "carta_texto": "El asesino no era rico ni pobre. Clase media. Alguien que pasa desapercibido. Eso ya dice algo.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 51,
          "carta_categoria": "grupal",
          "carta_texto": "El Coronel y el Notario llegaron juntos esa noche. Solo uno de ellos sabe por qué.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 74,
          "carta_categoria": "omerta",
          "carta_texto": "Dalton irrumpe en la sala y dispara mortalmente al sospechoso: ¡Eso es por mi esposa! y quien le defienda, directa o indirectamente, también será silenciado.",
