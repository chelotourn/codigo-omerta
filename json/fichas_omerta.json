      "cantidad": 4,
      "dificultad": "omerta",
      "culpable_id": 1,
      "culpable_nombre": "El Notario",
      "declaraciones": [
        {
          "sospechoso_id": 1,
          "sospechoso": "El Notario",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 69,
          "carta_categoria": "indirecta",
          "carta_texto": "Cuando alguien de la clase media miente, suele ser por sentimentalismo. Ese viejo impulso de proteger a los más jóvenes.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 63,
          "carta_categoria": "meta",
          "carta_texto": "Alguien acusa y alguien defiende, y ambos dicen la verdad. Eso es una contradicción. O es una trampa.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "media",
          "edad": "joven",
          "carta_id": 22,
          "carta_categoria": "veracidad",
          "carta_texto": "Desconfíe de todos esos ricos. El porte les da una confianza que cuesta distinguir de la inocencia.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 62,
          "carta_categoria": "meta",
          "carta_texto": "Quien recurre a la mentira en esta sala delata su propia culpa; la inocencia es, por naturaleza, honesta.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 55,
          "carta_categoria": "grupal",
          "carta_texto": "Los viejos se protegen. Es lo único que les queda. Uno de ellos debe ser el asesino.",
          "silenciada": false,
          "es_verdad": false
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 19,
          "carta_categoria": "defensa",
          "carta_texto": "El culpable no era rico. Vi sus ropas. Menuda falta de gusto.",
          "silenciada": false,
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 5,
          "carta_categoria": "acusación",
          "carta_texto": "La Aprendiz aprendió demasiado rápido. Y alguien pagó el precio.",
          "silenciada": false,
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 9,
      "distrito_id": 1,
      "distrito_nombre": "Distrito Industrial",
