      "dificultad": "omerta",
      "culpable_id": 7,
      "culpable_nombre": "El Heredero",
      "declaraciones": [
        {
          "sospechoso_id": 1,
          "sospechoso": "El Notario",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 10,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino ya tenía la edad de quien no teme nada y el dinero de quien nunca tuvo que temerlo.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 64,
          "carta_categoria": "indirecta",
          "carta_texto": "No he escuchado una sola duda en esta sala, es como si los más reflexivos callaran, señal de que todos ellos mienten.",
          "es_verdad": false
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "media",
          "edad": "joven",
          "carta_id": 61,
          "carta_categoria": "meta",
          "carta_texto": "Al menos una descripción dicha en esta sala suena convincente. Aférrese a esa y le llevará al culpable.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 33,
          "carta_categoria": "descriptiva",
          "carta_texto": "El asesino era pobre. Su aliento olía a mandarina. Nunca lo olvidaré.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 66,
          "carta_categoria": "indirecta",
          "carta_texto": "Si el Vagabundo miente, entonces el asesino vino de abajo. La pobreza no es excusa, pero sí es pista.",
          "es_verdad": true
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "mediana",
          "carta_id": 11,
          "carta_categoria": "acusación",
          "carta_texto": "El asesino tenía los bolsillos vacíos y sintiendo el peso de los años se negó a llegar a viejo en la miseria. No lo culpo",
          "es_verdad": true
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "joven",
          "carta_id": 23,
          "carta_categoria": "veracidad",
          "carta_texto": "A su edad los viejos ya no se gastan en mentir. No temen a la verdad.",
          "es_verdad": false
        }
      ]
    },
    {
      "ficha_id": 9,
      "distrito_id": 1,
      "distrito_nombre": "Distrito Industrial",
      "es_conclusion": false,
