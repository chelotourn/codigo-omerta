          "edad": "viejo",
          "carta_id": 74,
          "carta_categoria": "omerta",
          "carta_texto": "Arthur Dalton ingresa de súbito a la sala y dispara mortalmente al sospechoso: ¡Eso es por mi esposa! Quien defienda a esta rata correrá su misma suerte, será silenciado.",
          "silenciada": false,
