          "clase": "rico",
          "edad": "viejo",
          "carta_id": 72,
          "carta_categoria": "indirecta",
          "carta_texto": "Si nadie acusa directamente al culpable, es porque este los está presionando. Pero los pobres no tienen nada que perder y dirán la verdad.",
          "silenciada": false,
          "es_verdad": false,
          "distrito_origen": 2
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "media",
          "edad": "joven",
          "carta_id": 30,
          "carta_categoria": "veracidad",
          "carta_texto": "Curiosamente, quienes dicen la verdad esta noche podrían perfectamente comprarla.",
          "silenciada": false,
          "es_verdad": false,
          "distrito_origen": 2
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 73,
