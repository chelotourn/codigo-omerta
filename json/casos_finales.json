          "distrito_origen": 1
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 60,
          "carta_categoria": "meta",
          "carta_texto": "De las declaraciones que escuché ahí hoy al menos la mitad o más son puras mentiras. Calcule a quién le conviene mentir.",
          "silenciada": false,
