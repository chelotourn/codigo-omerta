      ],
      "cantidad": 3,
      "dificultad": "omerta",
      "culpable_id": 2,
      "culpable_nombre": "La Aprendiz",
      "declaraciones": [
        {
          "sospechoso_id": 1,
          "sospechoso": "El Notario",
          "clase": "rico",
          "edad": "viejo",
          "carta_id": 64,
          "carta_categoria": "indirecta",
          "carta_texto": "No he escuchado una sola duda razonable en esta sala, es como si los más reflexivos callaran, señal de que todos ellos mienten.",
          "silenciada": false,
          "es_verdad": false,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 2,
          "sospechoso": "La Aprendiz",
          "clase": "media",
          "edad": "joven",
          "carta_id": 54,
          "carta_categoria": "grupal",
          "carta_texto": "Los ricos en esta sala se cubren entre sí. Uno de ellos miente, uno de ellos lo hizo y no podra esconderlo.",
          "silenciada": false,
          "es_verdad": false,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 3,
          "sospechoso": "El Carnicero",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 71,
          "carta_categoria": "indirecta",
          "carta_texto": "Si al menos la mitad de los demás sospechosos miente, el culpable tiene años encima. La vejez enseña a esconderse.",
          "silenciada": true,
          "es_verdad": null,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 73,
          "carta_categoria": "omerta",
          "carta_texto": "Solo tengo una palabra para usted, detective: Omertá. Quien me acuse, directa o indirectamente, será silenciado.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 2
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 20,
          "carta_categoria": "defensa",
          "carta_texto": "Quien lo hizo no era de mediana edad. Esta claro pues no tuvo la fuerza para mover el cuerpo.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 46,
          "carta_categoria": "duda",
          "carta_texto": "Aqui el dinero se huele, y ese tipo no apestaba a clase media. Tampoco arrastraba los pies como un viejo. Es todo lo que sé.",
          "silenciada": false,
          "es_verdad": false,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 8,
          "sospechoso": "El Crupier",
          "clase": "media",
          "edad": "viejo",
          "carta_id": 62,
          "carta_categoria": "meta",
          "carta_texto": "Quien recurre a la mentira en esta sala delata su propia culpa; la inocencia es, por naturaleza, honesta.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 1
        }
      ]
    },
