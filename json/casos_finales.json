        },
        {
          "sospechoso_id": 4,
          "sospechoso": "El Coronel",
          "clase": "rico",
          "edad": "mediana",
          "carta_id": 15,
          "carta_categoria": "defensa",
          "carta_texto": "El Médico juró no hacer daño. Y lo cumple. Eso no se finge.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 5,
          "sospechoso": "La Vidente",
          "clase": "pobre",
          "edad": "viejo",
          "carta_id": 24,
          "carta_categoria": "veracidad",
          "carta_texto": "Los pobres no mienten pues hoy han comido bien. Yo les creo.",
          "silenciada": false,
          "es_verdad": false,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 6,
          "sospechoso": "El Médico",
          "clase": "media",
          "edad": "joven",
          "carta_id": 25,
          "carta_categoria": "veracidad",
          "carta_texto": "La experiencia no se oculta: al menos uno de mediana edad miente esta noche, aunque no sepamos cuál.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 7,
          "sospechoso": "El Heredero",
          "clase": "rico",
          "edad": "joven",
          "carta_id": 4,
          "carta_categoria": "acusación",
          "carta_texto": "La Vidente sabía lo que iba a pasar. Pero no creo en sus visiones, creo que lo planificó.",
          "silenciada": false,
          "es_verdad": true,
          "distrito_origen": 1
        },
        {
          "sospechoso_id": 9,
          "sospechoso": "El Vagabundo",
          "clase": "pobre",
          "edad": "mediana",
          "carta_id": 16,
